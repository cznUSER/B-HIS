# 复制为 web/.env.local 后再改。不要提交 .env.local，不要写入口令、JWT 或数据库连接串。
# 已提交的 web/.env 保持下面的 Mock，供默认 npm run dev。前端环境变量不放登录口令。

# --- Mock（默认，与 web/.env 相同）---
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080

# --- 本机真 API ---
# 启用时：注释掉上面三行 Mock，再取消下面一块的注释。保存后重新 npm run dev。
# 只认 false / 0 / no 关闭 Mock。API 默认监听 127.0.0.1:8080（config.example.yaml Host.ApiAddr）。
#
# 方式 A — 浏览器直连（页面源须在 API 的 CORS 白名单里，默认含 localhost:5173 与 127.0.0.1:5173）：
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
#
# 方式 B — 只访问 Vite，由开发服务器转发（浏览器不跨源，不依赖 CORS）：
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080

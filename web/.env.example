# 复制为 .env.local 后修改。.env.local 不提交。

# true：浏览器内 Mock，不请求后端。false：请求 VITE_API_BASE_URL。
VITE_USE_MOCK=true

# 须含契约前缀 /api/v1。
# 相对路径（/api/v1）由 Vite 开发服务器代理到 VITE_API_PROXY_TARGET。
# 绝对路径（http://localhost:8080/api/v1）由浏览器直连，后端需放行开发源 CORS。
VITE_API_BASE_URL=/api/v1

# 仅 `npm run dev` 代理使用。
VITE_API_PROXY_TARGET=http://localhost:8080
